# ---- Основное ----
NODE_ENV=production
PORT=3001
# Публичный адрес сайта (для проверки Origin и ссылок в уведомлениях)
PUBLIC_URL=http://pirant.kz

# ---- PostgreSQL ----
DATABASE_URL=postgres://pirant:CHANGE_ME@localhost:5432/pirant

# ---- Секреты (сгенерировать: openssl rand -hex 32) ----
JWT_SECRET=836797fa8bb23ae2385702c48e1fe00f93cb5f7cae7ef0dd3f861edc4acbf3b3
# Ключ шифрования TOTP-секретов, ровно 64 hex-символа
APP_ENC_KEY=49363da02bd3320a58f4cc4712cce419eebaf813708a8464dde8c5051fc986e7

# ---- Первый суперадмин (используется командой npm run create-admin) ----
ADMIN_LOGIN=admin
ADMIN_PASSWORD=12345678910

# ---- Двухфакторная защита входа в админку ----
REQUIRE_2FA=true

# ---- Загрузки ----
UPLOAD_DIR=./uploads

# ---- Telegram-бот для внутренних уведомлений (токен только здесь, не в коде и не в чате) ----
TELEGRAM_BOT_TOKEN=8692060430:AAHMSvDb-6A0Cn3ZSIunhoXy5I_tOKuvAbE

# ---- Почта (SMTP) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PIRANT сайт <no-reply@pirant.kz>"
# Кому слать уведомления, через запятую
NOTIFY_EMAILS=
